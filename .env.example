# Salin ke file .env untuk pengembangan lokal, lalu sesuaikan nilainya.
# CATATAN: file .env TIDAK di-commit ke git (lihat .gitignore).
#
# Development lokal (aktif):
VITE_API_BASE_URL=http://localhost:8000
#
# Production (deployment Vercel): set VITE_API_BASE_URL di Environment
# Variables Vercel (Production + Preview), bukan di file ini.
# VITE_API_BASE_URL=https://hepatwin-backend-py.fastapicloud.dev
